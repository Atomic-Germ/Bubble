[Unit]
Description=Bubble AI Chat Daemon
Documentation=file://%h/.local/lib/bubble/README.md
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/lib/bubble/bubble-daemon.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
# Forward overrides if set system-wide
# PassEnvironment=OFLM_SERVE_PORT BUBBLE_MODEL
# Optional semantic recall via /v1/embeddings (off|auto|on)
# PassEnvironment=BUBBLE_EMBEDDINGS_ENABLED BUBBLE_EMBED_MODEL BUBBLE_EMBED_MAX_RECALL BUBBLE_EMBED_TIMEOUT

[Install]
WantedBy=graphical-session.target
